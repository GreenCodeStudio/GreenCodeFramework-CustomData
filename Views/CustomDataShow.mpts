<form>
    <div class="topBarButtons">
        <a href=("/CustomData/edit/":item.id) class="button action-edit"><span class="icon-edit"></span>{{t("CommonBase.edit")}}
    </a>
</div>
<div class="grid page-CustomData page-CustomData-show">
<input name="id" type="hidden"/>
<section class=
("card action-":type) data-width="6">
<header>
    <h1>{{t("CustomData.CustomData.CustomData")}}</h1>
</header>
<div class="pseudoLabel">
    <span>{{t("CustomData.CustomData.custom_data_table_id")}}:</span>
    <strong>{{item.custom_data_table_id}}</strong>
</div>
<div class="pseudoLabel">
    <span>{{t("CustomData.CustomData.name")}}:</span>
    <strong>{{item.name}}</strong>
</div>
<div class="pseudoLabel">
    <span>{{t("CustomData.CustomData.type")}}:</span>
    <strong>{{item.type}}</strong>
</div>
<div class="pseudoLabel">
    <span>{{t("CustomData.CustomData.type_params")}}:</span>
    <strong>{{item.type_params}}</strong>
</div>
</section>
        </div>
        </form>
