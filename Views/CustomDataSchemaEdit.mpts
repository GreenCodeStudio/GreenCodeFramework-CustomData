<form>
    <div class="topBarButtons">
        <a href="/CustomDataSchema/" class="button"><span class="icon-cancel"></span>{{t("CommonBase.cancel")}}</a>
        <button class=("button action-":type) >
            <span class="icon-save"></span>
            {{t("CommonBase.save")}}
        </button>
    </div>
    <div class="grid page-CustomDataSchema page-CustomDataSchema-edit" >
        <input name="id" type="hidden"/>
        <section class=("card action-":type) data-width="6">
            <header>
                <h1>{{t("CustomData.CustomDataSchema.CustomDataSchema")}}</h1>
            </header>
            <label>
                <span>{{t("CustomData.CustomDataSchema.name")}}</span>
                <input type="text" name="name"/>
            </label>
            <div class="fields"> </div>
            <button class="addField" >{{t("CustomData.CustomDataSchema.addField")}}</button>
        </section>
    </div>
</form>
